{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/softprobe/openjob/schema/job.schema.json",
  "title": "Job",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "title",
    "company",
    "company_name",
    "role_slug",
    "location",
    "remote",
    "languages",
    "tags",
    "apply",
    "posted",
    "posted_by"
  ],
  "properties": {
    "kind": { "const": "job" },
    "title": { "type": "string", "minLength": 4, "maxLength": 120 },
    "company": { "$ref": "https://github.com/softprobe/openjob/schema/common.json#/$defs/slug" },
    "company_name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "role_slug": { "$ref": "https://github.com/softprobe/openjob/schema/common.json#/$defs/slug" },
    "location": { "type": "string", "minLength": 1, "maxLength": 80 },
    "remote": { "$ref": "https://github.com/softprobe/openjob/schema/common.json#/$defs/remote" },
    "languages": { "$ref": "https://github.com/softprobe/openjob/schema/common.json#/$defs/languages" },
    "tags": { "$ref": "https://github.com/softprobe/openjob/schema/common.json#/$defs/tags" },
    "apply": {
      "description": "An https application link, or mailto: for one hiring address on the company website's domain.",
      "oneOf": [
        { "$ref": "https://github.com/softprobe/openjob/schema/common.json#/$defs/httpsUrl" },
        { "$ref": "https://github.com/softprobe/openjob/schema/common.json#/$defs/mailtoUrl" }
      ]
    },
    "apply_email": {
      "description": "Optional mailto: hiring address on the company website's domain, used when apply is an https link.",
      "$ref": "https://github.com/softprobe/openjob/schema/common.json#/$defs/mailtoUrl"
    },
    "website": {
      "description": "Company site used to check a hiring address when this job has no company page.",
      "$ref": "https://github.com/softprobe/openjob/schema/common.json#/$defs/httpsUrl"
    },
    "posted": { "$ref": "https://github.com/softprobe/openjob/schema/common.json#/$defs/date" },
    "posted_by": { "$ref": "https://github.com/softprobe/openjob/schema/common.json#/$defs/github" },
    "expires": { "$ref": "https://github.com/softprobe/openjob/schema/common.json#/$defs/date" },
    "renewed": { "$ref": "https://github.com/softprobe/openjob/schema/common.json#/$defs/date" },
    "compensation": { "type": "string", "minLength": 1, "maxLength": 80 },
    "employment_type": {
      "description": "schema.org employmentType. One value, or a list.",
      "oneOf": [
        {
          "type": "string",
          "enum": ["FULL_TIME", "PART_TIME", "CONTRACTOR", "TEMPORARY", "INTERN", "VOLUNTEER", "PER_DIEM", "OTHER"]
        },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["FULL_TIME", "PART_TIME", "CONTRACTOR", "TEMPORARY", "INTERN", "VOLUNTEER", "PER_DIEM", "OTHER"]
          }
        }
      ]
    },
    "salary": {
      "description": "Structured pay. currency is ISO 4217. unit is the pay period. max, when set, is at least min.",
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "currency", "unit"],
      "properties": {
        "min": { "type": "number", "exclusiveMinimum": 0 },
        "max": { "type": "number", "exclusiveMinimum": 0 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "unit": { "enum": ["HOUR", "DAY", "WEEK", "MONTH", "YEAR"] }
      }
    },
    "locations": {
      "description": "Structured places. country is ISO 3166-1 alpha-2. The free-text location field is still required.",
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["country"],
        "properties": {
          "city": { "type": "string", "minLength": 1, "maxLength": 80 },
          "region": { "type": "string", "minLength": 1, "maxLength": 40 },
          "country": { "type": "string", "pattern": "^[A-Z]{2}$" }
        }
      }
    },
    "example": { "type": "boolean" }
  }
}
