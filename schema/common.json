{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/softprobe/openjob/schema/common.json",
  "title": "Shared OpenJob fields",
  "$defs": {
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "github": {
      "type": "string",
      "minLength": 1,
      "maxLength": 39,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38}$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "httpsUrl": {
      "type": "string",
      "minLength": 12,
      "maxLength": 300,
      "pattern": "^https://\\S+$"
    },
    "mailtoUrl": {
      "description": "A single hiring address. No display name, query string, or second recipient.",
      "type": "string",
      "minLength": 12,
      "maxLength": 300,
      "pattern": "^mailto:[A-Za-z0-9][A-Za-z0-9._%+-]{0,63}@[A-Za-z0-9](?:[A-Za-z0-9-]{0,62}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,62}[A-Za-z0-9])?)+$"
    },
    "remote": {
      "oneOf": [
        { "type": "boolean" },
        { "type": "string", "enum": ["hybrid"] }
      ]
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["en", "zh", "ja", "ko", "es", "fr", "de", "pt", "ru"]
      }
    },
    "tags": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 24,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "openTo": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["full-time", "part-time", "contract", "internship"]
      }
    }
  }
}
